{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "IdentityConnection": "Host=YOUR_HOST;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;TrustServerCertificate=true",
    "StoreConnection": "Host=YOUR_HOST;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;TrustServerCertificate=true"
  },

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "YOUR_EMAIL@gmail.com",
    "SenderPassword": "YOUR_EMAIL_APP_PASSWORD",
    "SenderName": "TechWise"
  },

  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },

  "BaseUrl": "https://localhost:7114",

  "JWTOptions": {
    "Issuer": "https://localhost:7114",
    "Audience": "MyStore",
    "SecurityKey": "STRONG_SECURITY_KEY_AT_LEAST_64_CHARS_LONG_REPLACE_THIS_WITH_YOUR_OWN",
    "DurationDays": 2
  },

  "StripeSettings": {
    "SecretKey": "sk_test_YOUR_STRIPE_SECRET_KEY",
    "PublishableKey": "pk_test_YOUR_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET"
  }
}